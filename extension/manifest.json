{
  "manifest_version": 3,
  "name": "JobHunter AI - LinkedIn Job & CV Copilot",
  "version": "1.1.0",
  "description": "Extract LinkedIn jobs, tailor your CV in 1-click using your AI Master Profile, and assist with applications.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "http://localhost:3000/*",
    "https://jobhunter-azure.vercel.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobHunter AI Copilot",
    "default_icon": "icons/icon48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/jobs/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jobhunter-azure.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": ["auth-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
