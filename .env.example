# Copy this file to .env.local and choose a provider.
# For Groq, use AI_PROVIDER=groq and add your Groq API key.
# For OpenAI, use AI_PROVIDER=openai and add your OpenAI API key.
AI_PROVIDER=groq

# Groq settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI settings (used when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Supabase database (server-side only; never use a NEXT_PUBLIC_ prefix)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Single-user app access (required in production)
APP_ACCESS_PASSWORD=choose_a_long_unique_password
APP_SESSION_SECRET=generate_at_least_32_random_characters
